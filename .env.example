# Copy to .env and adjust as needed. Never commit the real .env file.

POSTGRES_USER=carbon
POSTGRES_PASSWORD=change_me
POSTGRES_DB=carbon_intensity
POSTGRES_PORT=5432

# Used by scripts run directly on the host (outside Docker).
# Inside docker-compose, the `migrate` service builds its own DATABASE_URL
# pointing at the `db` service instead of localhost.
DATABASE_URL=postgresql+psycopg://carbon:change_me@localhost:5432/carbon_intensity
